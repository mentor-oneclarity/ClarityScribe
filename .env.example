# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# --- App ---
APP_URL=http://localhost:8000
LOG_LEVEL=INFO
LOCAL_MODE=true

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=meeting_bot
DB_USER=
DB_PASSWORD=

# --- Azure OpenAI (summaries) ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT_NAME=

# --- Bot / Google Meet ---
BOT_DISPLAY_NAME=Meeting Bot
BOT_GOOGLE_EMAIL=
BOT_GOOGLE_PASSWORD=
BOT_GUEST_MODE=true
BOT_MAX_CONCURRENT=1
BOT_SESSION_B64=
HEADLESS=true
AUDIO_DEVICE_INDEX=
PULSE_SINK=
PULSE_SOURCE=

# --- Google Calendar polling ---
CALENDAR_POLL_SEC=60
CALENDAR_LOOKAHEAD_MINUTES=10
DEFAULT_ORGANIZER_EMAIL=

# --- Email (AWS SES) ---
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_REGION=us-east-1
SES_FROM=

# --- API auth ---
# If set, all bot-control endpoints (join/stop/login/summarize/debug) require
# a matching X-API-Key header.
BOT_API_KEY=

# --- Optional: enrich push-summary with your own users table ---
# Leave USER_LOOKUP_TABLE empty to skip this lookup entirely (default).
USER_LOOKUP_TABLE=
USER_LOOKUP_EMAIL_COLUMN=email
USER_LOOKUP_ID_COLUMN=user_id
USER_LOOKUP_TENANT_COLUMN=tenant_id
